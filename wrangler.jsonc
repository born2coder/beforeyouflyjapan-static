{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beforeyouflyjapan-static",
  "compatibility_date": "2026-08-28",
  "main": "./worker.mjs",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "CONTACT_EMAIL_RATE_LIMIT",
      "namespace_id": "2026083001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "CONTACT_IP_RATE_LIMIT",
      "namespace_id": "2026083002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
